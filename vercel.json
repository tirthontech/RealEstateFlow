{
  "buildCommand": "npm install -g pnpm@10 && pnpm install --frozen-lockfile && cd artifacts/crm && pnpm build",
  "outputDirectory": "artifacts/crm/dist/public",
  "installCommand": "echo skip",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://realestateflow.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
