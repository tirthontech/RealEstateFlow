{
  "installCommand": "npm i -g pnpm && pnpm install",
  "buildCommand": "cd artifacts/crm && pnpm build",
  "outputDirectory": "artifacts/crm/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://realestateflow.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
